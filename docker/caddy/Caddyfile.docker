{
  admin off
  local_certs
  
  servers {
    protocols {$MEDIA_SYNC_CADDY_PROTOCOLS}
  }
}

{$MEDIA_SYNC_CADDY_SITE_LABEL} {
  tls internal

  encode gzip zstd

  @media path /media/* /thumbnails/*
  reverse_proxy @media host.docker.internal:8787 {
    header_up Host {host}
    transport http {
      versions 1.1
    }
  }

  @connectDevice path /connect/device
  reverse_proxy @connectDevice host.docker.internal:3000 {
    header_up Host {host}
  }

  @backend path \
    /api/* \
    /connect \
    /connect/register \
    /debug/* \
    /public/* \
    /player.html \
    /health \
    /healthz \
    /docs \
    /openapi.json \
    /favicon.ico \
    /favicon/* \
    /static/*

  reverse_proxy @backend host.docker.internal:8787 {
    header_up Host {host}
  }

  @next path /_next/*
  reverse_proxy @next host.docker.internal:3000 {
    header_up Host {host}
  }

  reverse_proxy host.docker.internal:3000 {
    header_up Host {host}
  }
}
