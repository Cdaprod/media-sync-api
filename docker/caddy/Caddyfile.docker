{
  admin off
  local_certs
}

{$MEDIA_SYNC_AUTHORITY_HOST}, 192.168.0.25 {
  tls internal

  encode gzip zstd

  @backend path /api/* /connect/* /media/* /thumbnails/* /public/* /player.html /health /healthz /docs /openapi.json /favicon.ico /favicon/* /static/*
  reverse_proxy @backend host.docker.internal:8787 {
    header_up Host {host}
    header_up X-Forwarded-Host {host}
    header_up X-Forwarded-Proto {scheme}
    header_up X-Forwarded-For {remote_host}
  }

  reverse_proxy host.docker.internal:3000 {
    header_up Host {host}
    header_up X-Forwarded-Host {host}
    header_up X-Forwarded-Proto {scheme}
    header_up X-Forwarded-For {remote_host}
  }
}
