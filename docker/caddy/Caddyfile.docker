{
  admin off
  local_certs
}

{$MEDIA_SYNC_AUTHORITY_HOST}, 192.168.0.25 {
  tls internal

  encode gzip zstd

  @media path /media/* /thumbnails/*
  reverse_proxy @media host.docker.internal:8787 {
    header_up Host {host}
    transport http {
      versions 1.1
    }
  }

  @backend path \
    /api/* \
    /connect/* \
    /public/* \
    /player.html \
    /health \
    /healthz \
    /docs \
    /openapi.json \
    /favicon.ico \
    /favicon/* \
    /static/*

  reverse_proxy @backend host.docker.internal:8787 {
    header_up Host {host}
  }

  reverse_proxy host.docker.internal:3000 {
    header_up Host {host}
  }
}
