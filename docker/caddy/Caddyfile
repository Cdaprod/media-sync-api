{
  admin off
  local_certs
}

{$MEDIA_SYNC_AUTHORITY_HOST}, 192.168.0.25 {
  tls internal

  encode gzip zstd

  @media path /media/* /thumbnails/*
  reverse_proxy @media 127.0.0.1:8787 {
    header_up Host {host}
    transport http {
      versions 1.1
    }
  }

  @backend path \
    /api/* \
    /connect* \
    /debug/* \
    /public/* \
    /player.html \
    /health \
    /healthz \
    /docs \
    /openapi.json \
    /favicon.ico \
    /favicon/* \
    /static/*

  reverse_proxy @backend 127.0.0.1:8787 {
    header_up Host {host}
  }

  @next path /_next/*
  reverse_proxy @next 127.0.0.1:3000 {
    header_up Host {host}
  }

  reverse_proxy 127.0.0.1:3000 {
    header_up Host {host}
  }
}
