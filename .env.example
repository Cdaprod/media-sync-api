# media-sync-api / Explorer local environment example
# Copy to repo root as .env before launching compose services:
#   cp .env.example .env

# API binding
MEDIA_SYNC_HOST=0.0.0.0
MEDIA_SYNC_PORT=8787

# Local projects root used by backend runtime
MEDIA_SYNC_PROJECTS_ROOT=/data/projects

# Authority/public origin contract used by connect-plane responses
MEDIA_SYNC_PUBLIC_ORIGIN=https://cda-DESKTOP.local
MEDIA_SYNC_AUTHORITY_ORIGIN=https://cda-DESKTOP.local

# Hostname-only value used by Caddy site label
MEDIA_SYNC_AUTHORITY_HOST=cda-DESKTOP.local

# Optional CORS additions (comma-separated)
# MEDIA_SYNC_CORS_ORIGINS=http://192.168.0.25:8790,http://localhost:8790

# Runtime role controls
APP_RUNTIME_ROLE=authority
# MEDIA_SYNC_NODE_ID=authority-main
# APP_INSTANCE_NAME=desktop-authority
